# Copy this file to .env and choose local-only credentials.
PROTOCOL=http
HOST=localhost

POSTGRES_DB=property_manager
POSTGRES_USER=property_manager
# Avoid URL-reserved characters because Compose uses this value in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
